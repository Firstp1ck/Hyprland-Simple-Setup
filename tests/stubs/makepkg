#!/usr/bin/env bash
set -euo pipefail
{
  printf 'makepkg cwd=%q' "$PWD"
  printf ' %q' "$@"
  printf '\n'
} >> "$STUB_LOG"
config=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --config) config=$2; shift 2 ;;
    *) shift ;;
  esac
done
[[ -n $config && -r $config ]]
# shellcheck disable=SC1090
source "$config"
auth_wrapper=${PACMAN_AUTH[0]:-}
[[ -n $auth_wrapper && -x $auth_wrapper ]]
printf 'makepkg-auth=%q\n' "$auth_wrapper" >> "$STUB_LOG"
"$auth_wrapper" /usr/bin/true
